{
  "name": "andy87/yii2-file-crafter",
  "description": "PHP library for Yii2 - developed by and_y87",
  "keywords": ["and_y87", "php", "generator", "crafter", "yii2", "library"],
  "homepage": "https://andy87.ru",
  "license": "MIT",

  "minimum-stability": "dev",

  "version": "dev-master",

  "authors": [
    {
      "name": "Kidin Andrey",
      "email": "kidin_a@list.ru"
    }
  ],

  "require": {
    "php": ">=8.0",
    "ext-json": "*"
  },

  "require-dev": {
    "yiisoft/yii2": "^2.0.53",
    "yiisoft/yii2-gii": "^2.2.7",
    "phpunit/phpunit": "^10.5",
    "symfony/dom-crawler": "^6.0",
    "symfony/browser-kit": "^6.0"
  },

  "autoload": {
    "psr-4": {
      "andy87\\yii2\\file_crafter\\": "src/"

    }
  },

  "autoload-dev": {
    "psr-4": {
      "andy87\\yii2\\file_crafter\\": "src/",
      "andy87\\yii2\\file_crafter\\tests\\": "tests/"
    }
  },

  "scripts": {
    "test": "vendor/bin/phpunit",
    "test:docs": "vendor/bin/phpunit --filter Readme --fail-on-warning --fail-on-risky --fail-on-incomplete --fail-on-skipped --fail-on-deprecation --fail-on-notice"
  },

  "config": {
    "allow-plugins": {
      "yiisoft/yii2-composer": true
    }
  },

  "repositories": [
    {
      "type": "composer",
      "url": "https://asset-packagist.org"
    }
  ]
}
